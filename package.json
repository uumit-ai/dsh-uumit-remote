{
  "name": "@uumit-ai/dsh-uumit-remote",
  "version": "0.1.0-beta.3",
  "description": "DeepSeek Harness plugin: open your DSH from your phone or any computer through UUMit, with pairing, access control and invitations. No desktop client needed.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-access",
    "uumit",
    "tunnel",
    "frp"
  ],
  "homepage": "https://github.com/uumit-ai/dsh-uumit-remote#readme",
  "bugs": {
    "url": "https://github.com/uumit-ai/dsh-uumit-remote/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uumit-ai/dsh-uumit-remote.git"
  },
  "author": "UUMit (https://uumit.com)",
  "contributors": [
    {
      "name": "GodBlessNoBugs",
      "url": "https://github.com/GodBlessNoBugs"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "src/**/*.html",
    "src/**/*.css",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:frps": "node --test test/e2e/*.test.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
